#!/bin/sh
# ==============================================================================
# freebsd-update-helper
#
# FreeBSD のホスト環境と Jail 環境に対して、freebsd-update および pkg コマンドを
# まとめて適用するためのヘルパースクリプト。
#
# 使い方:
#   freebsd-update-helper                              # メニューモード
#   freebsd-update-helper fetch  all                   # 全環境に freebsd-update fetch
#   freebsd-update-helper fetch  <jail> [<jail> ...]   # 指定 Jail に freebsd-update fetch
#   freebsd-update-helper install all                  # 全環境に freebsd-update install
#   freebsd-update-helper install <jail> [<jail> ...]  # 指定 Jail に freebsd-update install
#   freebsd-update-helper pkg update  all              # 全環境に pkg update
#   freebsd-update-helper pkg update  <jail> [...]     # 指定 Jail に pkg update
#   freebsd-update-helper pkg upgrade all              # 全環境に pkg upgrade
#   freebsd-update-helper pkg upgrade <jail> [...]     # 指定 Jail に pkg upgrade
#   freebsd-update-helper all                          # 全環境に全操作を順番に適用
#   freebsd-update-helper all <jail> [<jail> ...]      # 指定 Jail に全操作を順番に適用
#   freebsd-update-helper self-update                  # このスクリプト自体を GitHub から更新
#   freebsd-update-helper version                      # バージョンを表示
#
# ==============================================================================

# --- バージョン情報 ---
VERSION="1.1.2"

# --- GitHub 設定 (self-update 用) ---
GITHUB_USER="qlonix"
GITHUB_REPO="FreeBSD-update-helper"
GITHUB_BRANCH="master"
SELF_URL="https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_REPO}/${GITHUB_BRANCH}/freebsd-update-helper"

# --- スクリプト自身のパス ---
SELF_PATH="$(realpath "$0")"

# ==============================================================================
# ダイアログコマンドの検出
# 優先順位: bsddialog (FreeBSD 13.1+ ベースシステム) > dialog > なし (テキスト UI)
# ==============================================================================
_DIALOG_CMD=""
if command -v bsddialog > /dev/null 2>&1; then
	_DIALOG_CMD="bsddialog"
elif command -v dialog > /dev/null 2>&1; then
	_DIALOG_CMD="dialog"
fi
# _DIALOG_CMD が空のときはプレーンテキストメニューを使用する

# ==============================================================================
# ユーティリティ関数
# ==============================================================================

# ログ出力: 情報
log_info() {
	printf '\033[1;34m[INFO]\033[0m %s\n' "$*"
}

# ログ出力: 成功
log_ok() {
	printf '\033[1;32m[OK]\033[0m %s\n' "$*"
}

# ログ出力: 警告
log_warn() {
	printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2
}

# ログ出力: エラー
log_error() {
	printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
}

# セクション区切り表示
print_section() {
	printf '\n\033[1;36m========================================\033[0m\n'
	printf '\033[1;36m  %s\033[0m\n' "$*"
	printf '\033[1;36m========================================\033[0m\n\n'
}

# 端末状態をリセットする
# bsddialog/dialog はカーソル制御のため端末を raw モード等に変更する。
# コマンド実行前にこの関数を呼んで端末を通常状態に戻す。
reset_tty() {
	stty sane 2>/dev/null || true
}

# root 権限チェック
check_root() {
	if [ "$(id -u)" -ne 0 ]; then
		log_error "このスクリプトは root 権限で実行する必要があります。"
		exit 1
	fi
}

# Jail 名のバリデーション (ディレクトリトラバーサル・危険な文字を排除)
validate_jail_name() {
	_name="$1"
	# 英数字、ハイフン、アンダースコア、ドットのみ許可
	case "${_name}" in
		*[!A-Za-z0-9_.-]*)
			log_error "不正な Jail 名です: '${_name}'"
			return 1
			;;
		..*|..*)
			log_error "不正な Jail 名です: '${_name}'"
			return 1
			;;
	esac
	return 0
}

# 実行中の Jail 一覧を取得 (スペース区切りリスト)
get_running_jails() {
	jls -q name 2>/dev/null | tr '\n' ' '
}

# Jail のルートパスを取得
get_jail_path() {
	_jail="$1"
	jls -j "${_jail}" -q path 2>/dev/null
}

# Jail が実行中かチェック
is_jail_running() {
	_jail="$1"
	jls -q name 2>/dev/null | grep -qx "${_jail}"
}

# ホスト名を取得
get_hostname() {
	hostname -s
}

# ==============================================================================
# 実際の操作を行う関数
# ==============================================================================

# ホストに freebsd-update fetch を実行
do_fetch_host() {
	print_section "ホスト ($(get_hostname)) - freebsd-update fetch"
	freebsd-update fetch
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "ホストの freebsd-update fetch が完了しました。"
	else
		log_warn "ホストの freebsd-update fetch が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# 指定 Jail に freebsd-update fetch を実行
do_fetch_jail() {
	_jail="$1"
	validate_jail_name "${_jail}" || return 1

	if ! is_jail_running "${_jail}"; then
		log_warn "Jail '${_jail}' は実行中ではありません。スキップします。"
		return 0
	fi

	_path="$(get_jail_path "${_jail}")"
	if [ -z "${_path}" ]; then
		log_error "Jail '${_jail}' のパスを取得できませんでした。"
		return 1
	fi

	print_section "Jail: ${_jail} - freebsd-update fetch"
	freebsd-update -b "${_path}" fetch
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "Jail '${_jail}' の freebsd-update fetch が完了しました。"
	else
		log_warn "Jail '${_jail}' の freebsd-update fetch が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# ホストに freebsd-update install を実行
do_install_host() {
	print_section "ホスト ($(get_hostname)) - freebsd-update install"
	freebsd-update install
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "ホストの freebsd-update install が完了しました。"
	else
		log_warn "ホストの freebsd-update install が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# 指定 Jail に freebsd-update install を実行
do_install_jail() {
	_jail="$1"
	validate_jail_name "${_jail}" || return 1

	if ! is_jail_running "${_jail}"; then
		log_warn "Jail '${_jail}' は実行中ではありません。スキップします。"
		return 0
	fi

	_path="$(get_jail_path "${_jail}")"
	if [ -z "${_path}" ]; then
		log_error "Jail '${_jail}' のパスを取得できませんでした。"
		return 1
	fi

	print_section "Jail: ${_jail} - freebsd-update install"
	freebsd-update -b "${_path}" install
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "Jail '${_jail}' の freebsd-update install が完了しました。"
	else
		log_warn "Jail '${_jail}' の freebsd-update install が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# ホストに pkg update を実行
do_pkg_update_host() {
	print_section "ホスト ($(get_hostname)) - pkg update"
	pkg update
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "ホストの pkg update が完了しました。"
	else
		log_warn "ホストの pkg update が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# 指定 Jail に pkg update を実行
do_pkg_update_jail() {
	_jail="$1"
	validate_jail_name "${_jail}" || return 1

	if ! is_jail_running "${_jail}"; then
		log_warn "Jail '${_jail}' は実行中ではありません。スキップします。"
		return 0
	fi

	print_section "Jail: ${_jail} - pkg update"
	jexec "${_jail}" pkg update
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "Jail '${_jail}' の pkg update が完了しました。"
	else
		log_warn "Jail '${_jail}' の pkg update が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# ホストに pkg upgrade を実行
do_pkg_upgrade_host() {
	print_section "ホスト ($(get_hostname)) - pkg upgrade"
	pkg upgrade -y
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "ホストの pkg upgrade が完了しました。"
	else
		log_warn "ホストの pkg upgrade が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# 指定 Jail に pkg upgrade を実行
do_pkg_upgrade_jail() {
	_jail="$1"
	validate_jail_name "${_jail}" || return 1

	if ! is_jail_running "${_jail}"; then
		log_warn "Jail '${_jail}' は実行中ではありません。スキップします。"
		return 0
	fi

	print_section "Jail: ${_jail} - pkg upgrade"
	jexec "${_jail}" pkg upgrade -y
	_ret=$?
	if [ ${_ret} -eq 0 ]; then
		log_ok "Jail '${_jail}' の pkg upgrade が完了しました。"
	else
		log_warn "Jail '${_jail}' の pkg upgrade が非ゼロで終了しました (コード: ${_ret})。"
	fi
	return ${_ret}
}

# ==============================================================================
# 複数ターゲットへの一括適用関数
# ==============================================================================

# fetch を指定ターゲット群に適用
# 引数: "host" または Jail 名のリスト (スペース区切り)
run_fetch() {
	_targets="$*"
	_overall_ret=0
	for _t in ${_targets}; do
		if [ "${_t}" = "host" ]; then
			do_fetch_host || _overall_ret=$?
		else
			do_fetch_jail "${_t}" || _overall_ret=$?
		fi
	done
	return ${_overall_ret}
}

# install を指定ターゲット群に適用
run_install() {
	_targets="$*"
	_overall_ret=0
	for _t in ${_targets}; do
		if [ "${_t}" = "host" ]; then
			do_install_host || _overall_ret=$?
		else
			do_install_jail "${_t}" || _overall_ret=$?
		fi
	done
	return ${_overall_ret}
}

# pkg update を指定ターゲット群に適用
run_pkg_update() {
	_targets="$*"
	_overall_ret=0
	for _t in ${_targets}; do
		if [ "${_t}" = "host" ]; then
			do_pkg_update_host || _overall_ret=$?
		else
			do_pkg_update_jail "${_t}" || _overall_ret=$?
		fi
	done
	return ${_overall_ret}
}

# pkg upgrade を指定ターゲット群に適用
run_pkg_upgrade() {
	_targets="$*"
	_overall_ret=0
	for _t in ${_targets}; do
		if [ "${_t}" = "host" ]; then
			do_pkg_upgrade_host || _overall_ret=$?
		else
			do_pkg_upgrade_jail "${_t}" || _overall_ret=$?
		fi
	done
	return ${_overall_ret}
}

# 全操作 (fetch -> install -> pkg update -> pkg upgrade) を指定ターゲット群に適用
run_all_ops() {
	_targets="$*"
	log_info "対象: ${_targets}"
	log_info "順番に実行: fetch -> install -> pkg update -> pkg upgrade"
	run_fetch ${_targets}
	run_install ${_targets}
	run_pkg_update ${_targets}
	run_pkg_upgrade ${_targets}
}

# "all" 指定時のターゲットリストを構築 (host + 実行中の全 Jail)
build_all_targets() {
	_jails="$(get_running_jails)"
	printf 'host %s' "${_jails}"
}

# ==============================================================================
# self-update 機能
# ==============================================================================

cmd_self_update() {
	log_info "GitHub からスクリプトを更新します..."
	log_info "URL: ${SELF_URL}"

	# fetch コマンドの存在チェック (FreeBSD の fetch を優先)
	if command -v fetch > /dev/null 2>&1; then
		_dl_cmd="fetch -o"
	elif command -v curl > /dev/null 2>&1; then
		_dl_cmd="curl -fsSL -o"
	elif command -v wget > /dev/null 2>&1; then
		_dl_cmd="wget -O"
	else
		log_error "ダウンロードコマンドが見つかりません (fetch / curl / wget)。"
		exit 1
	fi

	_tmpfile="$(mktemp /tmp/freebsd-update-helper.XXXXXX)"

	# GitHub から最新版をダウンロード
	${_dl_cmd} "${_tmpfile}" "${SELF_URL}" || {
		log_error "ダウンロードに失敗しました。"
		rm -f "${_tmpfile}"
		exit 1
	}

	# ダウンロードしたファイルが空でないかチェック
	if [ ! -s "${_tmpfile}" ]; then
		log_error "ダウンロードしたファイルが空です。"
		rm -f "${_tmpfile}"
		exit 1
	fi

	# バックアップを作成してから置き換え
	cp -p "${SELF_PATH}" "${SELF_PATH}.bak"
	mv "${_tmpfile}" "${SELF_PATH}"
	chmod +x "${SELF_PATH}"

	log_ok "スクリプトを更新しました。バックアップ: ${SELF_PATH}.bak"
	"${SELF_PATH}" version
}

# ==============================================================================
# メニュー UI
# bsddialog (FreeBSD 13.1+ 標準) > dialog > プレーンテキスト の順で自動選択
# ==============================================================================

# --- ダイアログ版: ターゲット選択 ($() を使わない直接呼び出し版) ---
#
# 【設計の意図】
# bsddialog を $() (コマンド置換 = サブシェル) の中で実行すると、
# bsddialog が /dev/tty を ncurses モードに切り替えた状態がサブシェル内に
# 閉じ込められ、サブシェル終了後も親シェルの端末が壊れたままになる。
# これにより freebsd-update 等の出力・確認プロンプトが表示されなくなる。
#
# この関数は bsddialog を $() の外で直接呼び出し、選択結果を
# グローバル変数 _PICKED_TARGETS に格納することで問題を回避する。
_dlg_pick_targets() {
	_title="$1"
	_PICKED_TARGETS=""

	# --- ステップ1: 全体/個別 を選択 ---
	_tmpout="$(mktemp /tmp/fbsd-menu.XXXXXX)"
	${_DIALOG_CMD} \
		--clear \
		--title "${_title}" \
		--menu "対象を選択してください:" \
		12 52 2 \
		"all"    "全ての環境 (ホスト + 全 Jail)" \
		"select" "個別に選択" \
		2>"${_tmpout}"
	_ret=$?

	if [ ${_ret} -ne 0 ]; then
		rm -f "${_tmpout}"
		return 1
	fi

	_mode="$(cat "${_tmpout}")"
	rm -f "${_tmpout}"

	if [ "${_mode}" = "all" ]; then
		_PICKED_TARGETS="$(build_all_targets)"
		return 0
	fi

	# --- ステップ2: 個別選択 (Jail チェックリスト) ---
	_jails="$(get_running_jails)"
	if [ -z "$(printf '%s' "${_jails}" | tr -d ' ')" ]; then
		${_DIALOG_CMD} --msgbox "実行中の Jail がありません。" 7 40
		return 1
	fi

	_items=""
	for _j in ${_jails}; do
		_items="${_items} ${_j} 'Jail' off"
	done

	_tmpout2="$(mktemp /tmp/fbsd-menu.XXXXXX)"
	eval ${_DIALOG_CMD} \
		--clear \
		--title "'${_title}'" \
		--checklist "'対象を選択 (スペースで選択/解除、Enter で確定):'" \
		20 60 10 \
		"host" "'ホスト環境'" "off" \
		${_items} \
		2>"${_tmpout2}"
	_ret=$?

	if [ ${_ret} -ne 0 ]; then
		rm -f "${_tmpout2}"
		return 1
	fi

	_sel="$(cat "${_tmpout2}" | tr -d '"')"
	rm -f "${_tmpout2}"

	if [ -z "${_sel}" ]; then
		${_DIALOG_CMD} --msgbox "対象が選択されていません。" 7 40
		return 1
	fi

	_PICKED_TARGETS="${_sel}"
	return 0
}

# --- テキスト版: Jail 番号選択 ---
_text_select_jails() {
	_jails="$(get_running_jails)"
	_all_targets="host ${_jails}"

	printf '\n対象を番号で選択 (複数はスペース区切り、例: 1 3):\n'
	_i=1
	for _t in ${_all_targets}; do
		printf '  %d) %s\n' "${_i}" "${_t}"
		_i=$(( _i + 1 ))
	done
	printf '  0) キャンセル\n'
	printf '選択: '
	read -r _input < /dev/tty

	if [ -z "${_input}" ] || [ "${_input}" = "0" ]; then
		return 1
	fi

	# 入力番号をターゲット名に変換
	_result=""
	for _num in ${_input}; do
		_i=1
		for _t in ${_all_targets}; do
			if [ "${_num}" = "${_i}" ]; then
				_result="${_result} ${_t}"
				break
			fi
			_i=$(( _i + 1 ))
		done
	done

	if [ -z "${_result}" ]; then
		printf '対象が選択されていません。\n'
		return 1
	fi
	printf '%s' "${_result}"
}

# --- テキスト版: 全て/個別 サブメニュー ---
_text_select_targets() {
	_title="$1"
	printf '\n[%s] 対象を選択:\n' "${_title}"
	printf '  1) 全ての環境 (ホスト + 全 Jail)\n'
	printf '  2) 個別に選択\n'
	printf '  0) キャンセル\n'
	printf '選択: '
	read -r _ch < /dev/tty

	case "${_ch}" in
		1) printf '%s' "$(build_all_targets)" ;;
		2) _text_select_jails || return 1 ;;
		*) return 1 ;;
	esac
}

# --- テキスト版専用: ターゲット選択 ($() で呼んでも問題ない) ---
# テキスト版は bsddialog を使わないため $() 内で呼び出しても端末が壊れない
menu_select_targets() {
	_text_select_targets "$1"
}

# --- ダイアログ版メインメニュー ---
_menu_main_dialog() {
	while true; do
		_tmpout="$(mktemp /tmp/fbsd-menu.XXXXXX)"

		# メインメニューも $() 外で直接呼び出す
		${_DIALOG_CMD} \
			--clear \
			--title "FreeBSD Update Helper v${VERSION}" \
			--menu "操作を選択してください:" \
			18 64 8 \
			"1" "freebsd-update fetch" \
			"2" "freebsd-update install" \
			"3" "pkg update" \
			"4" "pkg upgrade" \
			"5" "全操作を順番に実行 (fetch/install/pkg update/upgrade)" \
			"6" "self-update (GitHub から最新版に更新)" \
			"7" "バージョン表示" \
			"q" "終了" \
			2>"${_tmpout}"
		_ret=$?

		_choice="$(cat "${_tmpout}")"
		rm -f "${_tmpout}"

		# キャンセルまたは ESC で終了
		if [ ${_ret} -ne 0 ] || [ "${_choice}" = "q" ]; then
			clear
			log_info "終了します。"
			exit 0
		fi

		# bsddialog を $() 外で呼び出し、端末状態を保護してからコマンドを実行する
		case "${_choice}" in
			1)
				_dlg_pick_targets "freebsd-update fetch" || continue
				reset_tty; clear; run_fetch ${_PICKED_TARGETS}
				printf '\n[Enter] でメニューに戻る: '; read -r _d < /dev/tty
				;;
			2)
				_dlg_pick_targets "freebsd-update install" || continue
				reset_tty; clear; run_install ${_PICKED_TARGETS}
				printf '\n[Enter] でメニューに戻る: '; read -r _d < /dev/tty
				;;
			3)
				_dlg_pick_targets "pkg update" || continue
				reset_tty; clear; run_pkg_update ${_PICKED_TARGETS}
				printf '\n[Enter] でメニューに戻る: '; read -r _d < /dev/tty
				;;
			4)
				_dlg_pick_targets "pkg upgrade" || continue
				reset_tty; clear; run_pkg_upgrade ${_PICKED_TARGETS}
				printf '\n[Enter] でメニューに戻る: '; read -r _d < /dev/tty
				;;
			5)
				_dlg_pick_targets "全操作を実行" || continue
				reset_tty; clear; run_all_ops ${_PICKED_TARGETS}
				printf '\n[Enter] でメニューに戻る: '; read -r _d < /dev/tty
				;;
			6)
				reset_tty; clear; cmd_self_update
				printf '\n[Enter] でメニューに戻る: '; read -r _d < /dev/tty
				;;
			7)
				${_DIALOG_CMD} --msgbox "FreeBSD Update Helper v${VERSION}" 7 44
				;;
		esac
	done
}

# --- プレーンテキスト版メインメニュー (bsddialog/dialog 不要) ---
_menu_main_text() {
	while true; do
		printf '\n'
		printf '========================================\n'
		printf '  FreeBSD Update Helper v%s\n' "${VERSION}"
		printf '========================================\n'
		printf '  1) freebsd-update fetch\n'
		printf '  2) freebsd-update install\n'
		printf '  3) pkg update\n'
		printf '  4) pkg upgrade\n'
		printf '  5) 全操作を順番に実行 (fetch/install/pkg update/upgrade)\n'
		printf '  6) self-update (GitHub から最新版に更新)\n'
		printf '  7) バージョン表示\n'
		printf '  q) 終了\n'
		printf '----------------------------------------\n'
		printf '選択: '
		read -r _choice < /dev/tty

		case "${_choice}" in
			1)
				_targets="$(menu_select_targets "freebsd-update fetch")" || continue
				run_fetch ${_targets}
				;;
			2)
				_targets="$(menu_select_targets "freebsd-update install")" || continue
				run_install ${_targets}
				;;
			3)
				_targets="$(menu_select_targets "pkg update")" || continue
				run_pkg_update ${_targets}
				;;
			4)
				_targets="$(menu_select_targets "pkg upgrade")" || continue
				run_pkg_upgrade ${_targets}
				;;
			5)
				_targets="$(menu_select_targets "全操作を実行")" || continue
				run_all_ops ${_targets}
				;;
			6)
				cmd_self_update
				;;
			7)
				printf 'FreeBSD Update Helper v%s\n' "${VERSION}"
				;;
			q|Q)
				log_info "終了します。"
				exit 0
				;;
			*)
				log_warn "無効な選択です: '${_choice}'"
				;;
		esac
	done
}

# --- メインメニュー: bsddialog/dialog の有無で自動切替 ---
menu_main() {
	if [ -n "${_DIALOG_CMD}" ]; then
		log_info "UI: ${_DIALOG_CMD} を使用します。"
		_menu_main_dialog
	else
		log_warn "bsddialog/dialog が見つかりません。プレーンテキストメニューで起動します。"
		_menu_main_text
	fi
}

# ==============================================================================
# ヘルプ表示
# ==============================================================================

show_help() {
	cat <<EOF
FreeBSD Update Helper v${VERSION}

使い方:
  $(basename "$0") [コマンド] [対象...]

コマンド:
  fetch   [all | <jail>...]      freebsd-update fetch を実行
  install [all | <jail>...]      freebsd-update install を実行
  pkg update   [all | <jail>...] pkg update を実行
  pkg upgrade  [all | <jail>...] pkg upgrade を実行
  all     [all | <jail>...]      上記4操作を順番に全て実行
  self-update                    GitHub から最新版に自己更新
  version                        バージョンを表示
  help                           このヘルプを表示

  ※ 対象に "all" を指定するとホスト + 全実行中 Jail が対象になります。
  ※ 引数なしで起動するとメニュー UI が起動します。
     (bsddialog または dialog が使えれば ncurses UI、なければテキスト UI)

例:
  $(basename "$0")                        # メニュー UI を起動
  $(basename "$0") fetch all              # 全環境に fetch
  $(basename "$0") fetch web db           # Jail "web" と "db" に fetch
  $(basename "$0") install all
  $(basename "$0") pkg update all
  $(basename "$0") pkg upgrade web
  $(basename "$0") all all                # 全環境に全操作
  $(basename "$0") all web db             # Jail "web" "db" に全操作
  $(basename "$0") self-update            # スクリプト自体を更新
EOF
}

# ==============================================================================
# エントリポイント
# ==============================================================================

# root 権限チェック
check_root

# 引数なし -> メニューモード
if [ $# -eq 0 ]; then
	menu_main
	exit 0
fi

# 引数あり -> CLI モード
_cmd="$1"
shift

case "${_cmd}" in
	# ---- fetch ----
	fetch)
		if [ $# -eq 0 ]; then
			log_error "対象を指定してください。例: fetch all / fetch <jail>..."
			exit 1
		fi
		if [ "$1" = "all" ]; then
			_targets="$(build_all_targets)"
		else
			_targets="$*"
		fi
		run_fetch ${_targets}
		;;

	# ---- install ----
	install)
		if [ $# -eq 0 ]; then
			log_error "対象を指定してください。例: install all / install <jail>..."
			exit 1
		fi
		if [ "$1" = "all" ]; then
			_targets="$(build_all_targets)"
		else
			_targets="$*"
		fi
		run_install ${_targets}
		;;

	# ---- pkg ----
	pkg)
		if [ $# -lt 2 ]; then
			log_error "サブコマンドと対象を指定してください。例: pkg update all"
			exit 1
		fi
		_subcmd="$1"
		shift
		if [ "$1" = "all" ]; then
			_targets="$(build_all_targets)"
		else
			_targets="$*"
		fi
		case "${_subcmd}" in
			update)
				run_pkg_update ${_targets}
				;;
			upgrade)
				run_pkg_upgrade ${_targets}
				;;
			*)
				log_error "不明な pkg サブコマンドです: '${_subcmd}' (update / upgrade)"
				exit 1
				;;
		esac
		;;

	# ---- all (全操作) ----
	all)
		if [ $# -eq 0 ]; then
			_targets="$(build_all_targets)"
		elif [ "$1" = "all" ]; then
			_targets="$(build_all_targets)"
		else
			_targets="$*"
		fi
		run_all_ops ${_targets}
		;;

	# ---- self-update ----
	self-update)
		cmd_self_update
		;;

	# ---- version ----
	version)
		printf 'FreeBSD Update Helper v%s\n' "${VERSION}"
		;;

	# ---- help ----
	help|--help|-h)
		show_help
		;;

	# ---- 不明なコマンド ----
	*)
		log_error "不明なコマンドです: '${_cmd}'"
		show_help
		exit 1
		;;
esac

exit 0
